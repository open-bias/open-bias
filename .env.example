# OpenBias environment variables
# Copy this file to .env and fill in your values.

# ── LLM Provider API Keys ──────────────────────────────────────────
# Set at least one. OpenBias auto-detects which provider to use.
OPENAI_API_KEY=sk-...
# ANTHROPIC_API_KEY=sk-ant-...
# GOOGLE_API_KEY=AIza...
# GEMINI_API_KEY=AIza...
# GROQ_API_KEY=gsk_...
# TOGETHERAI_API_KEY=...
# OPENROUTER_API_KEY=sk-or-...

# ── Tracing (optional) ─────────────────────────────────────────────
# OBIAS_OTEL__EXPORTER_TYPE=langfuse    # none | console | otlp | langfuse
# OBIAS_OTEL__ENDPOINT=http://localhost:4317

# Langfuse-specific (only if exporter_type=langfuse)
# OBIAS_OTEL__LANGFUSE_PUBLIC_KEY=pk-lf-...
# OBIAS_OTEL__LANGFUSE_SECRET_KEY=sk-lf-...
# OBIAS_OTEL__LANGFUSE_HOST=https://us.cloud.langfuse.com

# ── Policy overrides (optional) ────────────────────────────────────
# These override openbias.yaml values. Prefer using the YAML file.
# OBIAS_POLICY__ENGINE__TYPE=judge
# OBIAS_POLICY__ENGINE__CONFIG_PATH=./policy.yaml
# OBIAS_PROXY__PORT=4000
# OBIAS_DEBUG=false
